<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      allowBackup is off deliberately. The vault blob is encrypted, but Android
      auto-backup would still copy the salt and master-password verifier into
      the user's Google account, which weakens an offline attack for no benefit
      - a signed-in vault restores from Firestore anyway.
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link the home-screen widget uses to jump straight to the
                 QR unlock scanner. The app handles the biometric unlock itself
                 (reusing the existing flow), so there is no second prompt. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ciphervault" android:host="scan" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
          Autofill service. BIND_AUTOFILL_SERVICE means only the system may bind
          it. It reads an encrypted credential cache and shows nothing until the
          user passes a biometric prompt (AutofillUnlockActivity).
        -->
        <service
            android:name=".CipherVaultAutofillService"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <!-- The biometric gate the autofill dropdown launches. Transparent, no
             launcher icon; only the system starts it. -->
        <activity
            android:name=".AutofillUnlockActivity"
            android:exported="false"
            android:theme="@style/AutofillTransparent"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance" />

        <!-- Home-screen widget: one tap deep-links into the QR unlock scanner.
             The app's own biometric unlock is the gate, so the widget stays a
             plain launcher and holds nothing sensitive. -->
        <receiver
            android:name=".ScannerWidgetProvider"
            android:label="@string/widget_scanner_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/scanner_widget_info" />
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      The app is distributed through GitHub Releases rather than the Play
      Store, so it installs its own updates. The user still has to grant this
      explicitly in system settings on Android 8+; the permission alone does
      nothing.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Scanning the QR code shown by a signed-in desktop, to unlock it from this
      phone. The barcode-scanner plugin ships an empty manifest and does not
      declare this itself, so without it the scanner fails at runtime.
      Camera is optional hardware: everything else in the app works without it.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
</manifest>
